{
  "name": "ninja-plugin",
  "version": "1.1.66",
  "description": "OBS VDO.Ninja plugin",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test tests/e2e --reporter=line --workers=1",
    "test:e2e:view": "playwright test tests/e2e/vdoninja-view.spec.js --reporter=line",
    "test:e2e:reload": "playwright test tests/e2e/vdoninja-publish-view-reload.spec.js --reporter=line",
    "test:e2e:multi": "playwright test tests/e2e/vdoninja-multi-viewers.spec.js --reporter=line",
    "test:e2e:firefox-view": "node scripts/playwright-vdo-firefox-view-check.cjs",
    "test:e2e:vp9": "playwright test tests/e2e/vdoninja-vp9-view.spec.js --reporter=line",
    "test:audio-continuity": "node --test tests/test-audio-continuity.cjs",
    "test:video-continuity": "node --test tests/test-video-continuity.cjs",
    "test:presentation-continuity": "node --test tests/test-presentation-continuity.cjs",
    "test:audio-capture-control": "node scripts/playwright-audio-capture-control.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
